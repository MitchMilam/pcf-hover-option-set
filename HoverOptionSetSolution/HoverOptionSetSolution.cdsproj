<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PowerAppsTargetsPath>$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\PowerApps</PowerAppsTargetsPath>
  </PropertyGroup>

  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" />
  <Import Project="$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Solution.props" Condition="Exists('$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Solution.props')" />

  <PropertyGroup>
    <ProjectGuid>69a47b2b-fd56-4d53-8a28-827010414b75</ProjectGuid>
    <TargetFrameworkVersion>v4.6.2</TargetFrameworkVersion>
    <!--Remove TargetFramework when this is available in 16.1-->
    <TargetFramework>net462</TargetFramework>
    <SolutionName>PCFHoverOptionSet</SolutionName> 
    <PublisherName>nunosubtil</PublisherName> 
    <CustomizationPrefix>subtil</CustomizationPrefix> 
    <Version>1.0.0.1</Version> 
    <License>MIT</License> 
    <Description>A interactive option set field control for PowerApps developed by Nuno Subtil</Description>

    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <SolutionRootPath>src</SolutionRootPath>
  </PropertyGroup>

  <!-- 
    Solution Packager overrides, un-comment to use: SolutionPackagerType (Managed, Unmanaged, Both)
    Solution Localization Control, if you want to enabled localization of your solution, un-comment SolutionPackageEnableLocalization and set the value to true. - Requires use of -loc flag on Solution Clone or Sync
  -->
 
  <PropertyGroup>
    <SolutionPackageType>Both</SolutionPackageType>
    <SolutionPackageEnableLocalization>false</SolutionPackageEnableLocalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerApps.MSBuild.Solution" Version="1.*" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ExcludeDirectories Include="$(MSBuildThisFileDirectory)\.gitignore" />
    <ExcludeDirectories Include="$(MSBuildThisFileDirectory)\bin\**" />
    <ExcludeDirectories Include="$(MSBuildThisFileDirectory)\obj\**" />
    <ExcludeDirectories Include="$(MSBuildThisFileDirectory)\*.cdsproj" />
    <ExcludeDirectories Include="$(MSBuildThisFileDirectory)\*.cdsproj.user" />
    <ExcludeDirectories Include="$(MSBuildThisFileDirectory)\*.sln" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)\**" Exclude="@(ExcludeDirectories)" />
    <Content Include="$(SolutionPackageZipFilePath)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\pcf-hover-option-set.pcfproj" />
  </ItemGroup>

  <!--
    Copies the packaged zips to versioned filenames, so a build meant for one
    environment can't be mistaken for another. The version comes from
    Solution.xml rather than the Version property above, because Solution.xml is
    what the packager itself stamps into the solution.
  -->
  <Target Name="CopyVersionedSolutionZips" AfterTargets="Build">
    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)$(SolutionRootPath)\Other\Solution.xml"
             Query="/ImportExportXml/SolutionManifest/Version/text()">
      <Output TaskParameter="Result" ItemName="SolutionManifestVersion" />
    </XmlPeek>
    <PropertyGroup>
      <VersionedZipStem>$(OutputPath)$(MSBuildProjectName)_@(SolutionManifestVersion)</VersionedZipStem>
    </PropertyGroup>
    <Copy SourceFiles="$(OutputPath)$(MSBuildProjectName).zip"
          DestinationFiles="$(VersionedZipStem).zip"
          Condition="Exists('$(OutputPath)$(MSBuildProjectName).zip')" />
    <Copy SourceFiles="$(OutputPath)$(MSBuildProjectName)_managed.zip"
          DestinationFiles="$(VersionedZipStem)_managed.zip"
          Condition="Exists('$(OutputPath)$(MSBuildProjectName)_managed.zip')" />
    <Message Importance="high" Text="Versioned solution zips: $(VersionedZipStem)[_managed].zip" />
  </Target>

  <Import Project="$(MSBuildToolsPath)\Microsoft.Common.targets" />
  <Import Project="$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Solution.targets" Condition="Exists('$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Solution.targets')" />

</Project>
